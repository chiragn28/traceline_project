# Copy to .env for local docker-compose use.

DATABASE_URL=postgresql+psycopg://traceline_admin:traceline_admin@localhost:55432/traceline
APP_DATABASE_URL=postgresql+psycopg://traceline_app:traceline_app@localhost:55432/traceline

# JWT signing secret. Generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me
JWT_EXPIRE_MINUTES=480

# Fernet key used to encrypt data_source credentials at rest. A valid-format
# placeholder ships as the code default so local dev works out of the box --
# generate and set your own for anything beyond a throwaway local instance:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=csY5nV5XmVUOyW5snCB-F2_r1GfLpJ7LsgkaijhxmlE=

# TODO(hosting): the product's entire value proposition is data residency,
# so production deployment MUST target a UAE/nearby-region cloud (e.g.
# AWS me-central-1 / Azure UAE North / Oracle Cloud UAE), never a default
# us-east-1 dev region. Left as a TODO for local dev only.
DEPLOYMENT_REGION=local-dev-not-region-compliant
